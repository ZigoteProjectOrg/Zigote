<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <RootNamespace>Zigote.Http.Generators</RootNamespace>
        <AssemblyName>Zigote.Http.Generators</AssemblyName>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008: release tracking is for shipped analyzer packages; these diagnostics are internal to the build. -->
        <!-- NU5128: expected for an analyzer package — it deliberately ships nothing under lib/. -->
        <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
    </PropertyGroup>

    <!-- Analyzer packaging: the dll ships under analyzers/, never lib/ — a generator is a build
         tool, not a runtime reference. -->
    <PropertyGroup>
        <PackageId>Zigote.Http.Generators</PackageId>
        <Version>0.1.0</Version>
        <Authors>Zigote Project</Authors>
        <Description>Compile-time [HttpApi] clients for Zigote.Http: Retrofit's ergonomics with build errors instead of runtime proxies (ZHTTP001–005).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ZigoteProjectOrg/Zigote</RepositoryUrl>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true"
              PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>
</Project>
