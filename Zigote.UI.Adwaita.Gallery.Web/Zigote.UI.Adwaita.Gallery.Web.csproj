<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <!--
      Browser head for the Adwaita gallery: compiles the SAME gallery sources (no fork) against
      browser-wasm, like the iOS and Android heads.

        dotnet build Zigote.UI.Adwaita.Gallery.Web -p:ZigTargetRid=browser-wasm

      See build/Zigote.Web.targets.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Adwaita\Zigote.UI.Adwaita.csproj"/>
        <!-- The desktop gallery's own references: the heads compile the desktop gallery's
             sources verbatim, so they need what its pages need. -->
        <ProjectReference Include="..\Zigote.Graphs.Editor\Zigote.Graphs.Editor.csproj"/>
        <ProjectReference Include="..\Zigote.Modules.UI.CodeEditor\Zigote.Modules.UI.CodeEditor.fsproj"/>
        <ProjectReference Include="..\Zigote.Http\Zigote.Http.csproj"/>
        <ProjectReference Include="..\Zigote.Videoplayer\Zigote.Videoplayer.csproj"/>
        <ProjectReference Include="..\Zigote.Http.Generators\Zigote.Http.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Zigote.UI.Adwaita.Gallery\**\*.cs"
                 Exclude="..\Zigote.UI.Adwaita.Gallery\bin\**;..\Zigote.UI.Adwaita.Gallery\obj\**"/>
    </ItemGroup>

    <Import Project="..\build\Zigote.Web.targets"/>

</Project>
