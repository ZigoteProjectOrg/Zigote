<Project>
    <!--
      Repo-wide language pins. The SDK is pinned in global.json (10.0.110); this pins the language
      levels that SDK ships so a newer SDK on someone's machine can't silently change compilation.
      Per-project <LangVersion> overrides still win — none are set today.
    -->
    <PropertyGroup>
        <LangVersion Condition="'$(MSBuildProjectExtension)' == '.csproj'">14.0</LangVersion>
        <LangVersion Condition="'$(MSBuildProjectExtension)' == '.fsproj'">10.0</LangVersion>
        <!-- Keep dotnet test on VSTest for the mixed xUnit v2/v3 test projects.
             xUnit v3 4.0 defaults to MTP, which .NET 10 rejects in VSTest mode. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <!-- Package identity and one version for everything that ships (build/pack.sh). -->
    <Import Project="$(MSBuildThisFileDirectory)build/Zigote.Pack.props"/>
</Project>
