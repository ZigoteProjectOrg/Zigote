<Project>
  <!--
    Centralized build of the native Zig engine (libzigote) + per-RID copy into the output.
    Imported by Zigote.Core (the single project that owns the native dependency). Replaces the
    inline target that used to live in Zigote.Core.csproj.

    Responsibilities:
      * Build libzigote via `zig build shared-lib`, optimized, only when Zig sources change.
      * Cross-compile to the publish RID when it differs from the host (mac<->mac and ->linux work
        from any host; win-x64 needs a Windows host because of the MSVC ABI + wgpu .lib).
      * Copy exactly one native lib (the target platform's) into the output.
      * Force a rebuild when the build flags (optimize / 3D / target) change — the up-to-date check
        only watches sources, so a flag flip would otherwise be silently ignored.
  -->

  <PropertyGroup>
    <ZigEngineDir>$(MSBuildThisFileDirectory)..\Zigote.Engine</ZigEngineDir>
    <ZigOutLib>$(ZigEngineDir)\zig-out\lib</ZigOutLib>
    <ZigOutBin>$(ZigEngineDir)\zig-out\bin</ZigOutBin>

    <!-- Native optimization level. ReleaseFast for Release C# builds — the forward+ renderer is a
         tight per-pixel/per-draw path, so optimize for speed, not size (ReleaseSmall is ~-Os and
         leaves real performance on the table). ReleaseSafe otherwise keeps bounds/overflow checks
         for day-to-day iteration; set ZigOptimize=ReleaseFast for profiling-representative runs, or
         ZigOptimize=Debug for fast incremental native builds while editing the Zig engine. -->
    <ZigOptimize Condition="'$(ZigOptimize)' == '' And '$(Configuration)' == 'Release'">ReleaseFast</ZigOptimize>
    <ZigOptimize Condition="'$(ZigOptimize)' == ''">ReleaseSafe</ZigOptimize>
    <!-- ReleaseFast strips debug info by default (build.zig gates it on the optimize mode; ELF would
         otherwise embed ~90 MB of DWARF into libzigote.so). Set ZigStrip=false for a symbolized
         ReleaseFast build (profiling); Debug/ReleaseSafe keep symbols regardless. -->
    <ZigStripArg Condition="'$(ZigStrip)' != ''">-Dstrip=$(ZigStrip)</ZigStripArg>
    <!-- Enable3D=false builds the lean 2D-only native lib (drops the Assimp model importer). -->
    <Enable3D Condition="'$(Enable3D)' == ''">true</Enable3D>
    <!-- EnablePhysics3D=false drops the Jolt 3D-physics FFI; EnableEcs=false drops the flecs ECS FFI.
         Both default true (full engine). Independent of Enable3D — a pure-2D/UI app (2D physics is
         pure-C# Zigote.Physics2D; a widget app never touches World/ECS) can drop them for ~several MB.
         Game exports must leave these on (games need Jolt + the flecs-backed World at runtime). -->
    <EnablePhysics3D Condition="'$(EnablePhysics3D)' == ''">true</EnablePhysics3D>
    <EnableEcs Condition="'$(EnableEcs)' == ''">true</EnableEcs>
  </PropertyGroup>

  <!-- Resolve the target OS/arch from the publish RID (when set) or the host OS (plain build),
       then the zig target triple + native lib filename. -->
  <PropertyGroup>
    <!-- Prefer an explicit ZigTargetRid (publish.sh passes it as a global property so it reliably
         reaches this referenced project) over RuntimeIdentifier, which doesn't always propagate from
         the app's `dotnet publish -r` down to a ProjectReference's evaluation. -->
    <_Rid Condition="'$(ZigTargetRid)' != ''">$(ZigTargetRid)</_Rid>
    <_Rid Condition="'$(_Rid)' == ''">$(RuntimeIdentifier)</_Rid>

    <_RidOS Condition="$(_Rid.StartsWith('osx'))">macos</_RidOS>
    <_RidOS Condition="$(_Rid.StartsWith('win'))">windows</_RidOS>
    <!-- Order matters: 'android' RIDs must not fall into the generic 'linux' bucket (they map to
         the same OS tag but the -android ABI triple + NDK sysroot). iOS/Android are SCAFFOLDING:
         the triples resolve and wgpu-native prebuilts exist for them, but the vendored SDL build
         has no UIKit/Android video driver yet and iOS ultimately needs a static-lib step instead
         of a dylib — see docs/mobile-port.md before using these. -->
    <_RidOS Condition="$(_Rid.StartsWith('android'))">android</_RidOS>
    <_RidOS Condition="$(_Rid.StartsWith('ios'))">ios</_RidOS>
    <_RidOS Condition="'$(_RidOS)' == '' And $(_Rid.StartsWith('linux'))">linux</_RidOS>
    <!-- The iOS simulator is a distinct platform from the device (separate SDK, separate zig ABI
         suffix, separate wgpu prebuilt) — same _RidOS, different triple + SDK below. -->
    <_IosSimulator Condition="$(_Rid.StartsWith('iossimulator'))">true</_IosSimulator>
    <!-- iOS DEVICE links the engine statically into the app binary. A loose dylib in the bundle is
         rejected by AMFI at load ("code signature invalid"), and .NET links every other native
         piece (Mono included) into the executable there too — the simulator, which enforces no
         signing, keeps the dylib. -->
    <ZigStaticNative Condition="'$(_RidOS)' == 'ios' And '$(_IosSimulator)' != 'true'">true</ZigStaticNative>
    <ZigBuildStep Condition="'$(ZigStaticNative)' == 'true'">static-lib</ZigBuildStep>
    <ZigBuildStep Condition="'$(ZigBuildStep)' == ''">shared-lib</ZigBuildStep>
    <!-- With the engine linked into the app binary, DllImport must name "__Internal" (see
         NativeEngine.Lib). This is not merely cosmetic: the iOS SDK links with
         `-dead_strip -exported_symbols_list mtouch-symbols.list`, and the registrar only adds a
         native symbol to that list when a P/Invoke names __Internal — anything else is stripped,
         however hard the archive is force-loaded. -->
    <DefineConstants Condition="'$(ZigStaticNative)' == 'true'">$(DefineConstants);ZIGOTE_STATIC_NATIVE</DefineConstants>
    <_RidArch Condition="$(_Rid.EndsWith('-arm64'))">aarch64</_RidArch>
    <_RidArch Condition="$(_Rid.EndsWith('-x64'))">x86_64</_RidArch>

    <_HostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">macos</_HostOS>
    <_HostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_HostOS>
    <_HostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_HostOS>
    <_HostArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">aarch64</_HostArch>
    <_HostArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">x86_64</_HostArch>

    <ZigTargetOS Condition="'$(_RidOS)' != ''">$(_RidOS)</ZigTargetOS>
    <ZigTargetOS Condition="'$(ZigTargetOS)' == ''">$(_HostOS)</ZigTargetOS>

    <ZigNativeLib Condition="'$(ZigTargetOS)' == 'macos'">libzigote.dylib</ZigNativeLib>
    <ZigNativeLib Condition="'$(ZigTargetOS)' == 'linux'">libzigote.so</ZigNativeLib>
    <ZigNativeLib Condition="'$(ZigTargetOS)' == 'windows'">zigote.dll</ZigNativeLib>
    <ZigNativeLib Condition="'$(ZigTargetOS)' == 'android'">libzigote.so</ZigNativeLib>
    <!-- iOS forbids loading unsigned dylibs from the app sandbox: the engine must become a static
         archive linked into the host binary (DllImport "__Internal" via ZIGOTE_STATIC_NATIVE). The
         dylib name here only keeps the copy step coherent until that step exists. -->
    <ZigNativeLib Condition="'$(ZigTargetOS)' == 'ios'">libzigote.dylib</ZigNativeLib>
    <ZigNativeLib Condition="'$(ZigStaticNative)' == 'true'">libzigote.a</ZigNativeLib>

    <!-- Zig installs Windows DLLs into zig-out/bin (import lib + others in zig-out/lib); .so/.dylib
         go to zig-out/lib. ZigOutDir is where the loadable lib for this target lands. -->
    <ZigOutDir Condition="'$(ZigTargetOS)' == 'windows'">$(ZigOutBin)</ZigOutDir>
    <ZigOutDir Condition="'$(ZigOutDir)' == ''">$(ZigOutLib)</ZigOutDir>

    <!-- zig target triple, used only when cross-compiling (RID OS present and != host OS). Windows
         cross uses the GNU ABI: MSVC needs the MSVC SDK (unavailable when cross-compiling from
         macOS/Linux). A native Windows host builds without -Dtarget (ZigCross stays false). -->
    <_ZigTriple Condition="'$(_RidOS)' == 'macos' And '$(_RidArch)' != ''">$(_RidArch)-macos</_ZigTriple>
    <_ZigTriple Condition="'$(_RidOS)' == 'linux' And '$(_RidArch)' != ''">$(_RidArch)-linux-gnu</_ZigTriple>
    <_ZigTriple Condition="'$(_RidOS)' == 'windows' And '$(_RidArch)' != ''">$(_RidArch)-windows-gnu</_ZigTriple>
    <!-- The API suffix is mandatory: without it zig defaults Android to API 29, which disagrees
         with the NDK library directory the sysroot paths point at. -->
    <AndroidApiLevel Condition="'$(AndroidApiLevel)' == ''">34</AndroidApiLevel>
    <_ZigTriple Condition="'$(_RidOS)' == 'android' And '$(_RidArch)' != ''">$(_RidArch)-linux-android.$(AndroidApiLevel)</_ZigTriple>
    <_AndroidTriple Condition="'$(_RidOS)' == 'android' And '$(_RidArch)' != ''">$(_RidArch)-linux-android</_AndroidTriple>
    <!-- Android ABI directory names inside an APK's lib/ folder. -->
    <AndroidAbi Condition="'$(_RidOS)' == 'android' And '$(_RidArch)' == 'aarch64'">arm64-v8a</AndroidAbi>
    <AndroidAbi Condition="'$(_RidOS)' == 'android' And '$(_RidArch)' == 'x86_64'">x86_64</AndroidAbi>
    <_ZigTriple Condition="'$(_RidOS)' == 'ios' And '$(_RidArch)' != '' And '$(_IosSimulator)' != 'true'">$(_RidArch)-ios</_ZigTriple>
    <_ZigTriple Condition="'$(_RidOS)' == 'ios' And '$(_RidArch)' != '' And '$(_IosSimulator)' == 'true'">$(_RidArch)-ios-simulator</_ZigTriple>

    <!-- iOS constraints: Debug/ReleaseSafe zig builds reference std.debug's
         _dyld_get_image_header_containing_address, absent from the iOS tbds — force ReleaseFast.
         Assimp/Jolt/flecs are not yet validated for iOS cross-builds, and the UI apps being
         brought up there don't use them — force the lean set until they are. -->
    <ZigOptimize Condition="'$(_RidOS)' == 'ios'">ReleaseFast</ZigOptimize>
    <Enable3D Condition="'$(_RidOS)' == 'ios'">false</Enable3D>
    <EnablePhysics3D Condition="'$(_RidOS)' == 'ios'">false</EnablePhysics3D>
    <!-- ECS stays ON for iOS. With the engine statically linked, DllImport names __Internal and
         EVERY generated P/Invoke must resolve at link time — and the bindings are generated from
         the Zig sources regardless of build flags, so gating flecs out leaves 12 dangling
         zigote_ecs_* symbols. (3D and Jolt have stub implementations that keep exporting their
         names, which is why only ECS breaks.) flecs is plain C and cross-compiles cleanly. -->
    <EnableEcs Condition="'$(_RidOS)' == 'ios'">true</EnableEcs>
    <!-- Same reasoning as iOS: Assimp (C++) and Jolt are not yet validated against the NDK, and
         the apps being brought up do not use them; ECS stays on so the generated P/Invoke set
         resolves. Android keeps the .so (no static-link requirement — only iOS forbids one). -->
    <Enable3D Condition="'$(_RidOS)' == 'android'">false</Enable3D>
    <EnablePhysics3D Condition="'$(_RidOS)' == 'android'">false</EnablePhysics3D>
    <EnableEcs Condition="'$(_RidOS)' == 'android'">true</EnableEcs>
    <ZigCross Condition="'$(_RidOS)' != '' And '$(_RidOS)' != '$(_HostOS)'">true</ZigCross>
    <!-- Same-OS cross-ARCH (e.g. osx-x64 from an arm64 Mac) is a cross build too — without -Dtarget
         zig builds a host-arch lib that gets bundled into the foreign-arch RID and fails to load. -->
    <ZigCross Condition="'$(_RidOS)' == '$(_HostOS)' And '$(_RidArch)' != '' And '$(_RidArch)' != '$(_HostArch)'">true</ZigCross>
    <ZigTargetArg Condition="'$(ZigCross)' == 'true'">-Dtarget=$(_ZigTriple)</ZigTargetArg>
  </PropertyGroup>

  <ItemGroup>
    <!-- Watch the engine's own Zig sources + build files for the up-to-date check. Exclude the
         dependency/build caches (zig-pkg/zig-cache/zig-out) so the check stays fast. -->
    <ZigSourceFiles Include="$(ZigEngineDir)\src\**\*.zig" />
    <!-- WGSL shaders are @embedFile'd into the library, so editing one must retrigger the native
         build + output copy. Without this an edited shader silently keeps rendering the old code
         (the incremental up-to-date check only saw .zig sources). -->
    <ZigSourceFiles Include="$(ZigEngineDir)\src\**\*.wgsl" />
    <!-- build.zig also compiles the Objective-C platform shims and the vendored C/C++ under
         libraries/ — same staleness trap as the shaders: without these an edit there silently
         ships the previous dylib. -->
    <ZigSourceFiles Include="$(ZigEngineDir)\src\**\*.m" />
    <ZigSourceFiles Include="$(ZigEngineDir)\libraries\**\*.zig" />
    <ZigSourceFiles Include="$(ZigEngineDir)\libraries\**\*.c" />
    <ZigSourceFiles Include="$(ZigEngineDir)\libraries\**\*.h" />
    <ZigSourceFiles Include="$(ZigEngineDir)\libraries\**\*.cpp" />
    <ZigSourceFiles Include="$(ZigEngineDir)\build.zig" />
    <ZigSourceFiles Include="$(ZigEngineDir)\build.zig.zon" />
    <UpToDateCheckInput Include="@(ZigSourceFiles)" />
  </ItemGroup>

  <!-- Force a native rebuild when the build flags change (the up-to-date check only watches sources).
       We stamp the resolved flags next to zig-out and delete the outputs when they differ. -->
  <Target Name="ZigFlagsGuard" BeforeTargets="BuildZigEngine">
    <PropertyGroup>
      <_ZigFlags>$(ZigOptimize)|$(Enable3D)|$(EnablePhysics3D)|$(EnableEcs)|$(_ZigTriple)|$(ZigCross)|$(ZigStrip)</_ZigFlags>
      <_ZigFlagsFile>$(ZigEngineDir)\zig-out\.zig-build-flags</_ZigFlagsFile>
      <_PrevZigFlags Condition="Exists('$(_ZigFlagsFile)')">$([System.IO.File]::ReadAllText('$(_ZigFlagsFile)').Trim())</_PrevZigFlags>
    </PropertyGroup>
    <!-- Delete ALL stale native libs on a flag flip, including the versioned variants build.zig emits
         (libzigote.0.dylib / libzigote.0.1.0.dylib, libzigote.so.0.1.0). Deleting only the top-level
         symlink left the real versioned file behind, which a later up-to-date check could treat as
         current — so a lean (e.g. -Denable3d=false) lib could survive a flip back to the full editor set. -->
    <ItemGroup Condition="'$(_PrevZigFlags)' != '$(_ZigFlags)'">
      <_StaleNativeLib Include="$(ZigOutLib)\libzigote*.dylib;$(ZigOutLib)\libzigote*.so*;$(ZigOutBin)\zigote*.dll" />
    </ItemGroup>
    <Delete Condition="'$(_PrevZigFlags)' != '$(_ZigFlags)'" Files="@(_StaleNativeLib)" />
    <MakeDir Directories="$(ZigEngineDir)\zig-out" />
    <WriteLinesToFile Condition="'$(_PrevZigFlags)' != '$(_ZigFlags)'"
                      File="$(_ZigFlagsFile)" Lines="$(_ZigFlags)" Overwrite="true" />
  </Target>

  <!-- macOS→macOS cross-arch needs the SDK as an explicit sysroot: zig only auto-detects the SDK
       (frameworks, libSystem) for native targets, so a -Dtarget=x86_64-macos build from an arm64
       host fails on SDL/miniaudio/Cocoa without it. Resolved here (not in the static PropertyGroup)
       because it shells out to xcrun. -->
  <Target Name="ZigMacosSysroot" BeforeTargets="BuildZigEngine"
          Condition="'$(ZigCross)' == 'true' And '$(ZigTargetOS)' == 'macos' And '$(_HostOS)' == 'macos'">
    <Exec Command="xcrun --show-sdk-path" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MacSdkPath" />
    </Exec>
    <PropertyGroup>
      <ZigSysrootArg>--sysroot "$(_MacSdkPath)"</ZigSysrootArg>
    </PropertyGroup>
  </Target>

  <!-- iOS: zig bundles no iOS libc headers and the sysroot flag alone adds no include paths, so
       the SDK must be spelled out twice: as the sysroot (frameworks/link) AND as a generated
       zig libc file (usr/include). The SDK differs between device (iphoneos) and simulator. -->
  <Target Name="ZigIosSysroot" BeforeTargets="BuildZigEngine" Condition="'$(ZigTargetOS)' == 'ios'">
    <PropertyGroup>
      <_IosSdkName Condition="'$(_IosSimulator)' == 'true'">iphonesimulator</_IosSdkName>
      <_IosSdkName Condition="'$(_IosSdkName)' == ''">iphoneos</_IosSdkName>
    </PropertyGroup>
    <Exec Command="xcrun --sdk $(_IosSdkName) --show-sdk-path" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_IosSdkPath" />
    </Exec>
    <PropertyGroup>
      <_ZigIosLibcFile>$(ZigEngineDir)\zig-out\.zig-libc-ios.txt</_ZigIosLibcFile>
    </PropertyGroup>
    <MakeDir Directories="$(ZigEngineDir)\zig-out" />
    <WriteLinesToFile File="$(_ZigIosLibcFile)" Overwrite="true"
                      Lines="include_dir=$(_IosSdkPath)/usr/include;sys_include_dir=$(_IosSdkPath)/usr/include;crt_dir=;msvc_lib_dir=;kernel32_lib_dir=;gcc_dir=" />
    <PropertyGroup>
      <ZigSysrootArg>--sysroot "$(_IosSdkPath)" --libc "$(_ZigIosLibcFile)"</ZigSysrootArg>
    </PropertyGroup>
  </Target>

  <!-- Android: zig bundles no bionic headers, so the NDK sysroot must be spelled out as both the
       sysroot (system libraries) and a generated zig libc file (headers + crt objects). The libc
       file is generated per build rather than committed because it embeds absolute NDK paths. -->
  <Target Name="ZigAndroidSysroot" BeforeTargets="BuildZigEngine" Condition="'$(ZigTargetOS)' == 'android'">
    <PropertyGroup>
      <AndroidNdkRoot Condition="'$(AndroidNdkRoot)' == ''">$(ANDROID_NDK_ROOT)</AndroidNdkRoot>
      <AndroidNdkRoot Condition="'$(AndroidNdkRoot)' == ''">$(HOME)/Library/Android/sdk/ndk/26.2.11394342</AndroidNdkRoot>
      <!-- The prebuilt directory is named darwin-x86_64 even on Apple silicon (the only one shipped). -->
      <_NdkSysroot>$(AndroidNdkRoot)/toolchains/llvm/prebuilt/darwin-x86_64/sysroot</_NdkSysroot>
      <_ZigAndroidLibcFile>$(ZigEngineDir)/zig-out/.zig-libc-android-$(_RidArch).txt</_ZigAndroidLibcFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NdkSysroot)')"
           Text="Android NDK sysroot not found at '$(_NdkSysroot)'. Set AndroidNdkRoot or ANDROID_NDK_ROOT." />
    <MakeDir Directories="$(ZigEngineDir)/zig-out" />
    <WriteLinesToFile File="$(_ZigAndroidLibcFile)" Overwrite="true"
                      Lines="include_dir=$(_NdkSysroot)/usr/include;sys_include_dir=$(_NdkSysroot)/usr/include/$(_AndroidTriple);crt_dir=$(_NdkSysroot)/usr/lib/$(_AndroidTriple)/$(AndroidApiLevel);msvc_lib_dir=;kernel32_lib_dir=;gcc_dir=" />
    <PropertyGroup>
      <ZigSysrootArg>--sysroot "$(_NdkSysroot)" --libc "$(_ZigAndroidLibcFile)"</ZigSysrootArg>
    </PropertyGroup>
  </Target>

  <Target Name="BuildZigEngine" BeforeTargets="BeforeBuild"
          Inputs="@(ZigSourceFiles)" Outputs="$(ZigOutDir)\$(ZigNativeLib)">
    <Message Importance="high" Text="Zigote native: zig build $(ZigBuildStep) -Doptimize=$(ZigOptimize) -Denable3d=$(Enable3D) -Dphysics3d=$(EnablePhysics3D) -Decs=$(EnableEcs) $(ZigTargetArg) $(ZigStripArg) $(ZigSysrootArg)" />
    <Exec Command="zig build $(ZigBuildStep) -Doptimize=$(ZigOptimize) -Denable3d=$(Enable3D) -Dphysics3d=$(EnablePhysics3D) -Decs=$(EnableEcs) $(ZigTargetArg) $(ZigStripArg) $(ZigSysrootArg)"
          WorkingDirectory="$(ZigEngineDir)" IgnoreStandardErrorWarningFormat="true" />
    <!-- Apple's linker rejects zig's archives outright ("member not 8-byte aligned"), and Apple's
         libtool silently drops members when fed one, because zig also writes members with mode
         000. Repack each archive the only way that survives both: extract the objects, make them
         readable, and let libtool build a Darwin-format archive from the objects. -->
    <Exec Condition="'$(ZigStaticNative)' == 'true'" WorkingDirectory="$(ZigOutLib)"
          Command="set -e; for a in *.a; do d=`mktemp -d`; cp &quot;$a&quot; &quot;$d/in.a&quot;; (cd &quot;$d&quot; &amp;&amp; ar x in.a &amp;&amp; rm in.a &amp;&amp; chmod 644 *.o &amp;&amp; libtool -static -o out.a *.o 2&gt;/dev/null); cp &quot;$d/out.a&quot; &quot;$a&quot;; rm -rf &quot;$d&quot;; done" />
  </Target>

  <!-- Copy the target platform's native lib (and, on Windows, the wgpu_native.dll it links against)
       into the output / publish dir. .NET resolves @(Content) transitively into referencing apps. -->
  <ItemGroup>
    <!-- No Exists() guard: these are produced by BuildZigEngine (which runs BeforeBuild), so the file
         is present by the time MSBuild copies content. An Exists() check is evaluated at project load
         — before the build — and would drop the lib on a fresh/target-switched build. -->
    <Content Include="$(ZigOutDir)\$(ZigNativeLib)" Condition="'$(ZigStaticNative)' != 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>$(ZigNativeLib)</Link>
    </Content>
    <Content Include="$(ZigOutBin)\wgpu_native.dll" Condition="'$(ZigTargetOS)' == 'windows'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>wgpu_native.dll</Link>
    </Content>
  </ItemGroup>
</Project>
