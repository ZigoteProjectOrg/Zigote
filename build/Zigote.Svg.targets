<Project>
  <!--
    Builds native/zigote-svg (resvg behind a five-function C ABI) and copies the shared library
    into the output. Imported by Zigote.UI, the only project that P/Invokes it.

    Rust is REQUIRED, like Zig. It used to be optional — a checkout without cargo still built, and
    SvgPicture threw DllNotFoundException on first use instead. That traded a hard prerequisite for
    a warning nobody reads: the four SvgAssetTests simply failed on every machine without Rust, and
    the failure looked like a broken test rather than a missing toolchain.

    The toolchain version is pinned in native/zigote-svg/rust-toolchain.toml, the way the engine
    pins Zig in Zigote.Engine/.zigversion. rustup honours that file automatically; a
    distro-packaged cargo does not, so the version is checked here too and mismatches warn.
  -->

  <PropertyGroup>
    <SvgCrateDir>$(MSBuildThisFileDirectory)..\native\zigote-svg</SvgCrateDir>

    <!-- Same RID resolution as Zigote.Native.targets: an explicit publish RID wins, else the
         project's, else the host (plain build). -->
    <_SvgRid Condition="'$(ZigTargetRid)' != ''">$(ZigTargetRid)</_SvgRid>
    <_SvgRid Condition="'$(_SvgRid)' == ''">$(RuntimeIdentifier)</_SvgRid>

    <!-- RID → rust target triple. Windows uses the MSVC ABI (rust's default there, and the one a
         .NET app links against); the gnu ABI the Zig cross-build needs does not apply — this
         library links nothing but libc. -->
    <_SvgTriple Condition="'$(_SvgRid)' == 'linux-x64'">x86_64-unknown-linux-gnu</_SvgTriple>
    <_SvgTriple Condition="'$(_SvgRid)' == 'linux-arm64'">aarch64-unknown-linux-gnu</_SvgTriple>
    <_SvgTriple Condition="'$(_SvgRid)' == 'osx-x64'">x86_64-apple-darwin</_SvgTriple>
    <_SvgTriple Condition="'$(_SvgRid)' == 'osx-arm64'">aarch64-apple-darwin</_SvgTriple>
    <_SvgTriple Condition="'$(_SvgRid)' == 'win-x64'">x86_64-pc-windows-msvc</_SvgTriple>
    <_SvgTriple Condition="'$(_SvgRid)' == 'android-arm64'">aarch64-linux-android</_SvgTriple>
    <_SvgTriple Condition="'$(_SvgRid)' == 'android-x64'">x86_64-linux-android</_SvgTriple>
    <!-- ponytail: no iOS. A cdylib cannot be loaded from an iOS app sandbox, so that target needs
         the staticlib + __Internal treatment the Zig engine already has (ZigStaticNative). Add it
         when an iOS app actually needs SVG. -->

    <_SvgCargoTarget Condition="'$(_SvgTriple)' != ''">--target $(_SvgTriple)</_SvgCargoTarget>
    <_SvgOutDir Condition="'$(_SvgTriple)' != ''">$(SvgCrateDir)\target\$(_SvgTriple)\release</_SvgOutDir>
    <_SvgOutDir Condition="'$(_SvgTriple)' == ''">$(SvgCrateDir)\target\release</_SvgOutDir>

    <_SvgLibName Condition="$(_SvgRid.StartsWith('win')) Or ('$(_SvgRid)' == '' And '$([MSBuild]::IsOSPlatform(`Windows`))' == 'true')">zigote_svg.dll</_SvgLibName>
    <_SvgLibName Condition="'$(_SvgLibName)' == '' And ($(_SvgRid.StartsWith('osx')) Or ('$(_SvgRid)' == '' And '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true'))">libzigote_svg.dylib</_SvgLibName>
    <_SvgLibName Condition="'$(_SvgLibName)' == ''">libzigote_svg.so</_SvgLibName>
  </PropertyGroup>

  <ItemGroup>
    <SvgCrateSources Include="$(SvgCrateDir)\src\**\*.rs" />
    <SvgCrateSources Include="$(SvgCrateDir)\Cargo.toml" />
    <SvgCrateSources Include="$(SvgCrateDir)\Cargo.lock" />
    <UpToDateCheckInput Include="@(SvgCrateSources)" />
  </ItemGroup>

  <Target Name="BuildSvgNative" BeforeTargets="BeforeBuild"
          Inputs="@(SvgCrateSources)" Outputs="$(_SvgOutDir)\$(_SvgLibName)">
    <Exec Command="cargo --version" ContinueOnError="true" StandardOutputImportance="low"
          StandardErrorImportance="low" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_SvgCargoMissing" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_SvgCargoVersion" />
    </Exec>
    <Error Condition="'$(_SvgCargoMissing)' != '0'"
           Text="cargo not found. Rust is required to build Zigote (it builds native/zigote-svg, the SVG renderer behind SvgPicture). Install it from https://rustup.rs — rustup will pick up the pinned toolchain in native/zigote-svg/rust-toolchain.toml automatically." />

    <!-- Advisory: rustup already selects the pinned toolchain from rust-toolchain.toml. This only
         catches a distro cargo, which ignores that file. -->
    <PropertyGroup>
      <_SvgPinnedRust>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(SvgCrateDir)/rust-toolchain.toml')), 'channel\s*=\s*"([^"]+)"').Groups[1].Value)</_SvgPinnedRust>
    </PropertyGroup>
    <Warning Condition="'$(_SvgPinnedRust)' != '' And '$(_SvgCargoVersion)' != '' And !$(_SvgCargoVersion.Contains('$(_SvgPinnedRust)'))"
             Text="cargo is '$(_SvgCargoVersion.Trim())' but native/zigote-svg/rust-toolchain.toml pins $(_SvgPinnedRust). Install rustup (https://rustup.rs) to get the pinned toolchain selected automatically." />

    <Exec Command="cargo build --release $(_SvgCargoTarget)"
          WorkingDirectory="$(SvgCrateDir)" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- Added AFTER BuildSvgNative rather than at project load. As a plain ItemGroup this was
       evaluated before the crate had been built, so the first build on a fresh machine produced the
       library and copied nothing, and only the second build worked — which read exactly like the
       build being broken. -->
  <Target Name="CollectSvgNative" AfterTargets="BuildSvgNative" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="$(_SvgOutDir)\$(_SvgLibName)" Condition="Exists('$(_SvgOutDir)\$(_SvgLibName)')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>$(_SvgLibName)</Link>
      </Content>
    </ItemGroup>
  </Target>

</Project>
