<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Playground</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Adwaita\Zigote.UI.Adwaita.csproj"/>
        <!-- For the Internationalization page's examples. -->
        <ProjectReference Include="..\Zigote.UI.Localizations\Zigote.UI.Localizations.csproj"/>
        <!-- C# highlighting for the example editors. -->
        <ProjectReference Include="..\Zigote.Modules.UI.CodeEditor\Zigote.Modules.UI.CodeEditor.fsproj"/>
        <!-- Examples compile in-process: edit, ⌘S, the preview swaps. JIT only — Roslyn emits IL,
             so this app has no AOT publish. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0"/>
        <!-- The formatter (Formatter.GetFormattedTextChanges) lives in Workspaces, not the compiler. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0"/>
    </ItemGroup>
    <ItemGroup>
        <!-- The pages. Embedded so the app has no content directory to lose. -->
        <EmbeddedResource Include="Docs\**\*.md" LogicalName="Docs/%(RecursiveDir)%(Filename)%(Extension)"/>
        <!-- Curated widget-catalog samples: example sources compiled at runtime like the docs'
             live examples, so they are resources, not part of this build. -->
        <Compile Remove="Catalog\Samples\**"/>
        <EmbeddedResource Include="Catalog\Samples\*.cs" LogicalName="Samples/%(Filename)%(Extension)"/>
    </ItemGroup>
</Project>
