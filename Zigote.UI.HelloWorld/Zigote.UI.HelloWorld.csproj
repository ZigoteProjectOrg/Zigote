<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The whole example needs exactly two references: the widget kernel and the Material
             vocabulary on top of it. No engine, scene, scripting or editor coupling. -->
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Material\Zigote.UI.Material.csproj"/>
        <!-- The Shift+D debug overlay. Referencing it is enough to auto-install it; Program.cs
             installs it explicitly to choose the 2D profile. -->
        <ProjectReference Include="..\Zigote.UI.DevTools\Zigote.UI.DevTools.csproj"/>
    </ItemGroup>

</Project>
