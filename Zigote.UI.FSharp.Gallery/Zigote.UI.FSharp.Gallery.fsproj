<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Zigote.UI.FSharp.Gallery</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Ui.fs"/>
        <Compile Include="NekosPage.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.302"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zigote.UI.FSharp\Zigote.UI.FSharp.fsproj"/>
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Material\Zigote.UI.Material.csproj"/>
        <!-- Swift-Charts-style charting — the Desk tab's real-time portfolio line/area. -->
        <ProjectReference Include="..\Zigote.UI.Charts\Zigote.UI.Charts.csproj"/>
        <!-- The debug menu (Shift+D). Apps opt in — the F# layer stays DevTools-agnostic. -->
        <ProjectReference Include="..\Zigote.UI.DevTools\Zigote.UI.DevTools.csproj"/>
        <!-- The Http tab: the library and its F# pipeline surface. -->
        <ProjectReference Include="..\Zigote.Http\Zigote.Http.csproj"/>
        <ProjectReference Include="..\Zigote.Http.FSharp\Zigote.Http.FSharp.fsproj"/>
    </ItemGroup>

    <!-- NativeAOT publish opt-in (gated behind ZigoteAot; build/publish.sh AOT flag). Plain build/run
         stays JIT. F# adds FSharp.Core + the F# UI layer to the shared UI-stack roots; printf/format and
         the reconciler reflect over these, so keep their members. -->
    <Import Project="..\build\Zigote.Aot.targets"/>
    <ItemGroup Condition="'$(ZigoteAot)' == 'true'">
        <TrimmerRootAssembly Include="FSharp.Core"/>
        <TrimmerRootAssembly Include="Zigote.UI.FSharp"/>
    </ItemGroup>

</Project>
