<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Zigote.UI.FSharp</RootNamespace>
        <AssemblyName>Zigote.UI.FSharp</AssemblyName>
    </PropertyGroup>

    <!-- The whole module: F# ergonomics over Zigote.Core.State, plus the window bootstrap. The UI is
         the C# widget API used directly (see the header comment in Reactive.fs) — no view DSL, no
         generated attribute vocabulary, nothing to keep in sync with the widgets. -->
    <ItemGroup>
        <Compile Include="Reactive.fs"/>
        <Compile Include="Host.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.302"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zigote.Core\Zigote.Core.csproj"/>
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Material\Zigote.UI.Material.csproj"/>
    </ItemGroup>

</Project>
