<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Zigote.Http.Benchmark</AssemblyName>
        <RootNamespace>Zigote.HttpBench</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
    </ItemGroup>
    <ItemGroup>
        <!-- The baseline is raw HttpClient over the same loopback server — in-box, so the benchmark
             measures the two stacks and nothing else. -->
        <ProjectReference Include="..\Zigote.Http\Zigote.Http.csproj"/>
    </ItemGroup>
</Project>
