<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Zigote.Player</RootNamespace>
        <AssemblyName>Zigote.Player</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Zigote.Runtime\Zigote.Runtime.csproj"/>
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Material\Zigote.UI.Material.csproj"/>
        <ProjectReference Include="..\Zigote.UI.Charts\Zigote.UI.Charts.csproj"/>
        <ProjectReference Include="..\Zigote.UI.DevTools\Zigote.UI.DevTools.csproj"/>
    </ItemGroup>
    <!-- Fonts are bundled by Zigote.UI (their canonical home) and flow into this app's Fonts/ output
         transitively via the Zigote.UI project reference. The engine loads them from Fonts/ next to the
         executable. Publish-time subsetting is applied repo-wide by Directory.Build.targets. -->
    <ItemGroup>
        <Using Include="Zigote.UI.Material"/>
    </ItemGroup>
</Project>
