<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Zigote.Bloc.Benchmark</AssemblyName>
        <RootNamespace>Zigote.BlocBench</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Zigote.Bloc pulls in Zigote.Core; nothing else, same as the library itself. The stream
             baseline in Baseline.cs is System.Threading.Channels, which is in-box — a benchmark that
             needed a package to state its baseline would be measuring that package. -->
        <ProjectReference Include="..\Zigote.Bloc\Zigote.Bloc.csproj"/>
    </ItemGroup>
</Project>
