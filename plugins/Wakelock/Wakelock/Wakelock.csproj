<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Platform plugin Wakelock: same build-time platform selection as Haptics —
      each target framework compiles exactly one Platforms/ folder, all implementations
      share one class name (WakelockDriver), and the shared code binds to it statically.
      No channels, no lifecycle, no engine dependency.
    -->
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Wakelock</RootNamespace>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
        <Version>0.1.0</Version>
        <Description>Keep the screen awake for Zigote apps: FLAG_KEEP_SCREEN_ON, idleTimerDisabled, an IOKit assertion, a Windows power request, the freedesktop screensaver inhibit.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wakelock.Tests"/>
    </ItemGroup>

    <!-- The Linux backend speaks D-Bus directly; everything else is an OS API. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Platforms/**/*.cs"/>
        <Compile Include="Platforms/Desktop/**/*.cs" Condition="'$(TargetFramework)' == 'net10.0'"/>
        <Compile Include="Platforms/Android/**/*.cs" Condition="'$(TargetFramework)' == 'net10.0-android'"/>
        <Compile Include="Platforms/iOS/**/*.cs" Condition="'$(TargetFramework)' == 'net10.0-ios'"/>
    </ItemGroup>

</Project>
