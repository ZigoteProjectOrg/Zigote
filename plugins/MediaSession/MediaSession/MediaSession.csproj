<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Platform plugin MediaSession: same build-time platform selection as Notifications — each
      target framework compiles exactly one Platforms/ folder, all implementations share one class
      name (MediaSessionDriver), and the shared MediaSessionClient binds to it statically.
    -->
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>MediaSession</RootNamespace>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
        <Version>0.1.0</Version>
        <Description>Lock-screen, headset and media-key controls for Zigote: MPRIS2 on Linux, a MediaSession with a foreground service on Android, MPNowPlayingInfoCenter on iOS.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MediaSession.Tests"/>
    </ItemGroup>

    <!-- The Linux backend speaks D-Bus directly; Android and iOS have OS APIs instead. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Platforms/**/*.cs"/>
        <Compile Include="Platforms/Desktop/**/*.cs" Condition="'$(TargetFramework)' == 'net10.0'"/>
        <Compile Include="Platforms/Android/**/*.cs" Condition="'$(TargetFramework)' == 'net10.0-android'"/>
        <Compile Include="Platforms/iOS/**/*.cs" Condition="'$(TargetFramework)' == 'net10.0-ios'"/>
    </ItemGroup>

</Project>
