<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Zigote.UI.Adwaita</RootNamespace>
        <AssemblyName>Zigote.UI.Adwaita</AssemblyName>
        <!-- The XML doc comments ship next to the DLL: IDEs show them, and Zigote.Playground's widget
             catalog is generated from them. CS1591 (undocumented public member) is not a defect. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- ponytail: the doc-comment checks below (bad cref/param/paramref) were never on before and
             fire ~80 times; silenced so builds stay quiet. Drop them from NoWarn to fix the backlog. -->
        <NoWarn>$(NoWarn);CS1591;CS1574;CS1573;CS1734;CS0419;CS1572</NoWarn>
    </PropertyGroup>
    <!-- Same seam Zigote.Core uses: internals that are pure logic (accelerator parsing, layout
         maths) are unit-tested directly rather than pushed into the public surface just to be
         reachable — this kit mirrors libadwaita's API, so it should not grow extras. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Zigote.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Zigote.UI\Zigote.UI.csproj"/>
        <ProjectReference Include="..\Zigote.UI.BottomSheet\Zigote.UI.BottomSheet.csproj"/>
    </ItemGroup>
</Project>
