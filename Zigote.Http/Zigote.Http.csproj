<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Zigote.Http</RootNamespace>
        <AssemblyName>Zigote.Http</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Standalone by design: no ProjectReference to Core. The frame API talks to the host
             through a provider delegate, the same shape Zigote.Scripting's Input/Audio use. -->
    </PropertyGroup>

    <!-- NuGet identity. net10.0-only on purpose: the code uses TimeProvider-based CTS, spans and
         collection expressions throughout; a downlevel TFM would be a different library. The .NET
         SDK embeds SourceLink for git repos on its own — no package needed. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Zigote.Http</PackageId>
        <Version>0.1.0</Version>
        <Authors>Zigote Project</Authors>
        <Description>HTTP for Zigote applications: requests as immutable values, errors as values, middleware as function composition — with an RFC 9111 cache subset, single-flight dedup, retry + circuit breaker, ranged reads, and a zero-allocation frame-loop queue.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ZigoteProjectOrg/Zigote</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>
</Project>
