<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Zigote.Core</RootNamespace>
        <AssemblyName>Zigote.Core</AssemblyName>
        <!-- The XML doc comments ship next to the DLL: IDEs show them, and Zigote.Playground's widget
             catalog is generated from them. CS1591 (undocumented public member) is not a defect.
             ponytail: the doc-comment checks after it were never on and fire on bad crefs/params;
             silenced so builds stay quiet. Drop them from NoWarn to fix the backlog. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1574;CS1573;CS1734;CS0419;CS1572;CS1587;CS1570</NoWarn>
    </PropertyGroup>

    <!-- Native Zig engine build + per-RID copy + Enable3D rebuild guard. -->
    <Import Project="..\build\Zigote.Native.targets"/>

    <ItemGroup>
        <ProjectReference Include="..\Zigote.Generators\Zigote.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <!-- desktop_shims_stub.zig is excluded: it re-exports the macOS-only menu/drag entry points as
         no-ops for other platforms, and those already have hand-written bindings in NativeMenu.cs
         (same partial class) — generating them again would duplicate the declarations. -->
        <!-- The wire contract: the generator reads the enums the exports return out of abi.zig
             and emits them, rather than having them hand-mirrored on this side. -->
        <AdditionalFiles Include="..\Zigote.Engine\src\abi.zig"/>
        <AdditionalFiles Include="..\Zigote.Engine\src\ffi\*.zig"
                         Exclude="..\Zigote.Engine\src\ffi\desktop_shims_stub.zig"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Zigote.ECS</_Parameter1>
        </AssemblyAttribute>
        <!-- Zigote.Runtime builds the scene command stream (SceneStream) from the generated wire
             structs and hands it to zigote_scene_apply. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Zigote.Runtime</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Zigote.Tests</_Parameter1>
        </AssemblyAttribute>
        <!-- Watch is one Effect named after its builder (diagnostics) and runs its swap untracked. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Zigote.UI</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Types\FrameArena.cs"/>
    </ItemGroup>

</Project>
